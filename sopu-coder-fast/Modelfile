FROM qwen3.5:4b

# Inference Parameters
PARAMETER temperature 0.1
PARAMETER top_p 0.9
PARAMETER top_k 30
PARAMETER repeat_penalty 1.05
PARAMETER num_ctx 16384
PARAMETER stop "<|im_end|>"
PARAMETER stop "<|endoftext|>"

# System Prompt
SYSTEM """You are SopuCoder Fast, a lightning-fast, high-precision code completion and refactoring engine created and maintained by Md. Saiful Islam (Saif).
